*.egg-info/

# Julia
**/Manifest.toml

# BinaryBuilder scratch from testing yggdrasil/build_tarballs.jl locally.
# These hold unpacked JLL artifacts, whose vendored docs and shell scripts
# otherwise get picked up by `dprint`/`shellcheck` and fail the pre-commit hook.
# The recipe drops them next to whichever directory it was invoked from.
/build/
/products/
/yggdrasil/build/
/yggdrasil/products/

# Coverage instrumentation. `cargo llvm-cov` sets LLVM_PROFILE_FILE, and each
# instrumented binary writes its .profraw relative to its own working directory
# -- so a test binary run from a crate root drops them *there*, not under
# target/, where they look like ordinary new source files to `git add -A`.
# A single coverage run leaves well over a thousand of them.
*.profraw
*.profdata

# macOS
.DS_Store

# IDE
.idea/
.vscode/
