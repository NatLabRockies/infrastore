#!/bin/sh
#
# Pre-commit hook for infrastore.

set -e

echo '+cargo fmt --all -- --check'
cargo fmt --all -- --check

echo '+cargo clippy --workspace --all-targets --all-features -- -D warnings'
cargo clippy --workspace --all-targets --all-features -- -D warnings

echo '+dprint check'
dprint check

if command -v shellcheck >/dev/null 2>&1; then
  # Lint only files git knows about (the index, so staged additions count).
  # Walking the tree instead picks up scripts we do not own, such as the
  # vendored netcdf-c shell scripts left behind by a local BinaryBuilder run.
  sh_files=$(git ls-files -- '*.sh')
  if [ -n "$sh_files" ]; then
    echo '+shellcheck (tracked .sh files)'
    echo "$sh_files" | xargs shellcheck
  fi
else
  echo 'shellcheck not found, skipping shell script linting'
fi

if git diff --cached --name-only -- 'julia/*.jl' | grep -q .; then
  if command -v julia >/dev/null 2>&1; then
    echo '+julia format check'
    julia --project=julia/formatter julia/formatter/format.jl --check
  else
    echo 'julia not found, skipping Julia format check'
  fi
fi
